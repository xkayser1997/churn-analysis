            "precision: 0.520 +/- 0.026\n",
            "roc_auc: 0.845 +/- 0.012\n"
          ]
        }
      ],
      "source": [
        "#Random Forest final tuned model cv results.\n",
        "final_rf = rf_grid.best_estimator_\n",
        "\n",
        "final_rf_cv_results = cross_validate(\n",
        "    final_rf,\n",
        "    X_train,\n",
        "    y_train,\n",
        "    cv=cv,\n",
        "    scoring=scoring\n",
        ")\n",
